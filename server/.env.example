# Template only. Set real secrets in Render's service environment, not in GitHub.
PORT=3000
DATABASE_URL=

# Optional: set to off only for local PostgreSQL without TLS.
# PGSSL=off

# Password-reset email: configure Resend or SMTP.
RESEND_API_KEY=
MAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Optional: public HTTPS origin for Jam invitation links.
# Render sets RENDER_EXTERNAL_URL automatically when this is omitted.
# JAM_PUBLIC_URL=

# Stripe subscriptions. Never commit real keys or webhook secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Optional: return URL used by Stripe's customer portal.
STRIPE_RETURN_URL=
