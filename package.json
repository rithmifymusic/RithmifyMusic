{
  "name": "gmajna-music-priv",
  "productName": "Rythmify",
  "version": "0.4.8",
  "description": "Private standalone music player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.gmajna.musicpriv",
    "protocols": [
      {
        "name": "Rythmify Jam invitation",
        "schemes": [
          "gmajna"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "renderer/img/rythmify.ico",
        "to": "rythmify.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "rithmifymusic",
        "repo": "RithmifyMusic",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "renderer/img/rythmify.ico",
      "signAndEditExecutable": true,
      "artifactName": "Rythmify-Setup-${version}.${ext}",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.8.0",
    "@ghostery/adblocker-electron-preload": "^2.8.0",
    "@xhayper/discord-rpc": "^1.5.1",
    "cross-fetch": "^4.1.0",
    "electron-updater": "^6.8.9",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
